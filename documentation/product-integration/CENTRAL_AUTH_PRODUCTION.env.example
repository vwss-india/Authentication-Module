APP_NAME="VisionWeb Central Auth"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://auth.example.invalid
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=REPLACE_WITH_VERIFIED_DATABASE_HOST
DB_PORT=5432
DB_DATABASE=REPLACE_WITH_CENTRAL_AUTH_DATABASE
DB_USERNAME=REPLACE_WITH_LEAST_PRIVILEGE_DATABASE_ROLE
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

TRUSTED_PROXIES=
SECURITY_CSP_ENABLED=true
CORS_PATHS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

MAIL_MAILER=smtp
# Set MAIL_SCHEME and MAIL_PORT from the approved provider's current TLS guidance.
MAIL_SCHEME=
MAIL_HOST=REPLACE_WITH_APPROVED_SMTP_HOST
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_FROM_ADDRESS
MAIL_FROM_NAME="VisionWeb Central Auth"

OIDC_ACCESS_TOKEN_EXPIRE_MINUTES=10
OIDC_ID_TOKEN_EXPIRE_MINUTES=5
OIDC_KEY_RETENTION_MINUTES=1440

# Passport keys are provisioned through controlled key custody, not environment text.
# APP_PREVIOUS_KEYS is optional and only used during a planned Laravel key transition.
